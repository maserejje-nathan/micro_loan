APP_NAME=LendFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database — use MySQL/MariaDB in production (recommended)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lendflow
DB_USERNAME=root
DB_PASSWORD=

# SQLite (local development only)
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR (optional — leave disabled unless you run a Node SSR server)
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# SMS (log | africas_talking)
SMS_DRIVER=log
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=
AFRICAS_TALKING_ENDPOINT=https://api.africastalking.com/version1/messaging

# Mobile money (stub | yo)
MOBILE_MONEY_DRIVER=stub
YO_PAYMENTS_USERNAME=
YO_PAYMENTS_PASSWORD=
YO_PAYMENTS_ACCOUNT=
YO_PAYMENTS_API_URL=https://paymentsapi1.yo.co.ug/ybs/task.php
YO_PAYMENTS_SANDBOX_API_URL=https://sandbox.yopayments.com/ybs/task.php
YO_PAYMENTS_SANDBOX=true
YO_PAYMENTS_NON_BLOCKING=true

# Platform super admin (created by SuperAdminSeeder — change before going live)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=password
SUPERADMIN_NAME="Super Admin"

# Demo lending company (created when SEED_DEMO_DATA=true)
SEED_DEMO_DATA=true
DEMO_ORGANIZATION_NAME="Kampala Micro Loans"
DEMO_OWNER_EMAIL=owner@demo.lendflow.test
DEMO_OWNER_PASSWORD=password
DEMO_OWNER_NAME="Sarah Nakato"
DEMO_PORTAL_PASSWORD=portal-demo

# Subdomain tenancy (e.g. acme.yourdomain.com)
TENANCY_SUBDOMAIN_ENABLED=false
TENANCY_BASE_DOMAIN=localhost
TENANCY_CENTRAL_HOSTS=localhost,127.0.0.1
